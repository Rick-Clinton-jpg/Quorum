# Copy to .env (gitignored) and fill in. Never commit real credentials.

# Option A - Gemini Developer API (simplest to get running):
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Option B - real Vertex AI (what the hackathon track's infra pillar wants
# for the deployed Cloud Run service): unset GOOGLE_API_KEY, set these
# instead, and make sure Application Default Credentials are available
# (e.g. `gcloud auth application-default login`, or a service account
# attached to the Cloud Run revision):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
